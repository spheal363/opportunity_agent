# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- DB ----
# MVP は SQLite。将来 PostgreSQL に差し替える場合も SQLAlchemy の URL を変えるだけ。
DATABASE_URL=sqlite:///./opportunity_agent.db

# ---- Frontend / CORS ----
# カンマ区切りで複数指定可
FRONTEND_URL=http://localhost:5173

# ---- LLM (OrcaRouter) ----
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=
LLM_MODEL_CHEAP=
LLM_MODEL_STANDARD=
LLM_MODEL_POWERFUL=

# ---- Web Search Tool ----
# MVP は Tavily（https://tavily.com）。tvly- で始まるキー。
# 別 provider へ差し替える場合は tools/search/ に実装を足す。
# --- 検索と本文取得 ---------------------------------------------------------
# **別々に選ぶ。** Serper は検索だけで本文を返さないため、検索を替えただけでは
# 抽出の入力が痩せる（#65）。既定は比較で採用が決まるまで現行のまま。
SEARCH_PROVIDER=tavily   # tavily | serper
PAGE_FETCHER=tavily      # tavily | jina

SEARCH_API_KEY=

# ---- Google Calendar ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Agent ----
# true の間は LLM を呼ばず、固定のモックデータで Agent Loop を流す（フロント結合用）
AGENT_STUB_MODE=true

# Serper（比較用）。無料枠 2,500 クエリ、カード不要。**単価は未確認。**
SERPER_API_KEY=
SERPER_GL=jp
SERPER_HL=ja

# Jina Reader（比較用）。**キー無しでも動く**（20 RPM）。キーがあると 500 RPM。
JINA_API_KEY=

# --- 評価器 -----------------------------------------------------------------
# llm  既定・現行。自由文の match_reasons も出る
# jev  分類・採点のみ。**自由文は作れない**
EVALUATOR=llm
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
# これを下回る confidence は既存 LLM へ回す。
# **confidence は正解率ではない**（公式が明記）。運用上の閾値として扱う。
JEV_MIN_CONFIDENCE=0.5

# --- 探索の構成 -------------------------------------------------------------
# full       既定・現行。見つけた候補を全件抽出して評価
# prefilter  抽出前に読む優先順位を付ける（構成 C）
SEARCH_PIPELINE=full
# 本文を読む候補の数。**仮説であって正解ではない。**
PREFILTER_READ_LIMIT=8
# 不足したときに追加で読む上限。無制限には増やさない。
PREFILTER_EXTRA_READS=4
