# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- DB ----
# MVP は SQLite。将来 PostgreSQL に差し替える場合も SQLAlchemy の URL を変えるだけ。
DATABASE_URL=sqlite:///./opportunity_agent.db

# ---- Frontend / CORS ----
# カンマ区切りで複数指定可
FRONTEND_URL=http://localhost:5173

# ---- LLM (OrcaRouter) ----
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=
LLM_MODEL_CHEAP=
LLM_MODEL_STANDARD=
LLM_MODEL_POWERFUL=

# ---- 探索経路（#47）----
# SEARCH_ROUTE=discovery  **既定。書かなければこちら。**
#   検索専用モデル（DISCOVERY_MODEL）に希望ごと並列で聞き、一覧を先に出す。
#   **必要な鍵は ORCAROUTER_API_KEY だけ。** 検索はモデルの内側で行われるので、
#   SERPER_API_KEY / TYPESAFE_API_KEY は要らない。
# SEARCH_ROUTE=legacy     従来の 検索->精読->抽出->評価->推薦 へ戻す。
#   そのときは下の SEARCH_PROVIDER / EVALUATOR に応じた鍵が要る。
SEARCH_ROUTE=discovery   # discovery | legacy
# 動作確認済みのモデル。**内蔵検索が応答に含まれる。**
DISCOVERY_MODEL=openai/gpt-5-search-api

# ---- Web Search Tool ----
# **SEARCH_ROUTE=legacy のときに使う。** discovery では使わない
#（詳細確認の本文取得だけは PAGE_FETCHER を使い、Jina は鍵なしで動く）。
# 別 provider へ差し替える場合は tools/search/ に実装を足す。
# --- 検索と本文取得 ---------------------------------------------------------
# **別々に選ぶ。** Serper は検索だけで本文を返さないため、検索を替えただけでは
# 抽出の入力が痩せる（#65）。
# **既定は構成 C（暫定採用）。** 根拠は docs/experiments/65-search-comparison.md
#
# A へ戻すには 4 つとも戻す:
#   SEARCH_PROVIDER=tavily PAGE_FETCHER=tavily EVALUATOR=llm SEARCH_PIPELINE=full
SEARCH_PROVIDER=serper   # tavily | serper
PAGE_FETCHER=jina        # tavily | jina

# Tavily（https://tavily.com）。tvly- で始まるキー。**構成 A では必須。**
SEARCH_API_KEY=

# ---- Google Calendar ----
# OAuth クライアントは「デスクトップアプリ」。使うアカウントを同意画面のテストユーザーに入れておく。
# 設定したら最初に 1 回だけ `.venv/bin/python -m scripts.google_auth` を実行する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 上のスクリプトが書き出すトークン（Secret。.gitignore 済み）
GOOGLE_TOKEN_PATH=.google_token.json

# ---- Agent ----
# true の間は LLM を呼ばず、固定のモックデータで Agent Loop を流す（フロント結合用）
AGENT_STUB_MODE=true

# Serper。**構成 C では必須。** 無料枠 2,500 クエリ、カード不要。単価は未確認。
# 無い場合は探索が「設定が足りません」で止まる（**別構成へは落ちない**）。
SERPER_API_KEY=
SERPER_GL=jp
SERPER_HL=ja

# Jina Reader（比較用）。**キー無しでも動く**（20 RPM）。キーがあると 500 RPM。
JINA_API_KEY=

# --- 評価器 -----------------------------------------------------------------
# llm  構成 A。自由文の match_reasons も出る
# jev  既定（構成 C）。分類・採点のみで、**自由文は作れない**
EVALUATOR=jev            # llm | jev
# **構成 C では必須。** 無い場合は探索が止まる。
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
# これを下回る confidence は既存 LLM へ回す。
# **confidence は正解率ではない**（公式が明記）。運用上の閾値として扱う。
JEV_MIN_CONFIDENCE=0.5

# --- 探索の構成 -------------------------------------------------------------
# full       構成 A。見つけた候補を全件抽出して評価
# prefilter  既定（構成 C）。抽出前に読む優先順位を付ける
SEARCH_PIPELINE=prefilter  # full | prefilter
# 本文を読む候補の数。**仮説であって正解ではない。**
PREFILTER_READ_LIMIT=8
# 不足したときに追加で読む上限。無制限には増やさない。
PREFILTER_EXTRA_READS=4

# --- モデル振り分け（#26-b）------------------------------------------------
# policy    既定。工程ごとの方針に従う（backend/ai/routing.py、docs に表あり）
# standard  表を無視して全工程 STANDARD。振り分けを入れる前へ戻す
# **現在はどちらでも実際の tier は同じ**（全工程 STANDARD）。違うのは
# 方針と理由がログに出るかどうか。
LLM_ROUTING=policy       # policy | standard

# Prompt Injection のデモ。true にすると攻撃を仕込んだページを検索結果に 1 件混ぜる。
# 検知して推薦から外す流れが探索中画面の Agent Log に出る（docs/security.md）
DEMO_INJECTION=false

# ---- 自動探索（Agent が自分で探索を始める, #84 / #85）----
# 自動にするのは発見だけ。Calendar への書き込みなど外部への操作は人の操作のまま。
# **既定はすべてオフ。** オンにしても下の上限をコードが強制する（backend/services/auto_explore.py）。
# 推薦の過半数に👎が付いたら探し直す
AUTO_EXPLORE_ON_FEEDBACK=false
# 定期チェック（推薦中の機会が締切切れで減った・前回の探索から時間がたった）
AUTO_EXPLORE_SCHEDULE=false
# 定期チェックの間隔（秒）
AUTO_EXPLORE_TICK_SECONDS=300
# 前回の探索からこれだけたったら新着を探す（分。1440 = 24 時間）
AUTO_EXPLORE_SCHEDULE_INTERVAL_MINUTES=1440
# 直近 24 時間の自動 run の回数上限
AUTO_EXPLORE_MAX_RUNS_PER_DAY=3
# 直近 24 時間の全 run（手動を含む）の見積もり額の合計の上限（円）。請求額ではない
AUTO_EXPLORE_MAX_COST_JPY_PER_DAY=20
# 自動 run 同士の最低間隔（分）
AUTO_EXPLORE_MIN_INTERVAL_MINUTES=60
# queued / running のまま進捗がこれだけ無い run は止まったものとみなす（分）
AUTO_EXPLORE_ABANDONED_AFTER_MINUTES=30
