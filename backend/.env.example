# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- DB ----
# MVP は SQLite。将来 PostgreSQL に差し替える場合も SQLAlchemy の URL を変えるだけ。
DATABASE_URL=sqlite:///./opportunity_agent.db

# ---- Frontend / CORS ----
# カンマ区切りで複数指定可
FRONTEND_URL=http://localhost:5173

# ---- LLM (OrcaRouter) ----
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=
LLM_MODEL_CHEAP=
LLM_MODEL_STANDARD=
LLM_MODEL_POWERFUL=

# ---- Web Search Tool ----
SEARCH_API_KEY=

# ---- Google Calendar ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Agent ----
# true の間は LLM を呼ばず、固定のモックデータで Agent Loop を流す（フロント結合用）
AGENT_STUB_MODE=true
