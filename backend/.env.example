# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- DB ----
# MVP は SQLite。将来 PostgreSQL に差し替える場合も SQLAlchemy の URL を変えるだけ。
DATABASE_URL=sqlite:///./opportunity_agent.db

# ---- Frontend / CORS ----
# カンマ区切りで複数指定可
FRONTEND_URL=http://localhost:5173

# ---- LLM (OrcaRouter) ----
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=
LLM_MODEL_CHEAP=
LLM_MODEL_STANDARD=
LLM_MODEL_POWERFUL=

# ---- Web Search Tool ----
# MVP は Tavily（https://tavily.com）。tvly- で始まるキー。
# 別 provider へ差し替える場合は tools/search/ に実装を足す。
SEARCH_API_KEY=

# ---- Google Calendar ----
# OAuth クライアントは「デスクトップアプリ」。使うアカウントを同意画面のテストユーザーに入れておく。
# 設定したら最初に 1 回だけ `.venv/bin/python -m scripts.google_auth` を実行する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 上のスクリプトが書き出すトークン（Secret。.gitignore 済み）
GOOGLE_TOKEN_PATH=.google_token.json

# ---- Agent ----
# true の間は LLM を呼ばず、固定のモックデータで Agent Loop を流す（フロント結合用）
AGENT_STUB_MODE=true
# Prompt Injection のデモ。true にすると攻撃を仕込んだページを検索結果に 1 件混ぜる。
# 検知して推薦から外す流れが探索中画面の Agent Log に出る（docs/security.md）
DEMO_INJECTION=false
